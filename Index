 function schedule(){if(!ticking){ticking=true;requestAnimationFrame(animate)}}
 function observeTiles(){
  if(observer)observer.disconnect();
  const tiles=[...gallery.querySelectorAll('.tile')];
  if(reduced.matches || !('IntersectionObserver' in window)){tiles.forEach(t=>t.classList.add('motion-visible'));schedule();return}
  observer=new IntersectionObserver(entries=>entries.forEach(entry=>{
   if(!entry.isIntersecting)return;
   const tile=entry.target;
   tile.classList.add('motion-visible');
   if(!tile.dataset.entered){
    tile.dataset.entered='1';
    tile.animate([{opacity:.45,filter:'brightness(.7)'},{opacity:1,filter:'brightness(1)'}],{duration:750,easing:'ease-out'});
   }
   observer.unobserve(tile);
  }),{threshold:.02,rootMargin:'0px 0px 60px 0px'});
  tiles.forEach(t=>observer.observe(t));schedule();
 }
 function setZoom(on){detailImg.classList.toggle('zoom',on);zoomIn.setAttribute('aria-pressed',String(on));if(!on){detailImg.parentElement.scrollTop=0;detailImg.parentElement.scrollLeft=0}}
 zoomIn.addEventListener('click',()=>setZoom(true));
 zoomOut.addEventListener('click',()=>setZoom(false));
 detailImg.addEventListener('click',()=>zoomIn.setAttribute('aria-pressed',String(detailImg.classList.contains('zoom'))));
 window.addEventListener('scroll',schedule,{passive:true});window.addEventListener('resize',schedule,{passive:true});
 if(reduced.addEventListener)reduced.addEventListener('change',()=>{observeTiles();schedule()});
 // Filters replace gallery tiles dynamically; reattach animation every time.
 new MutationObserver(()=>observeTiles()).observe(gallery,{childList:true});
 document.documentElement.classList.add('js-motion');observeTiles();schedule();
})();
</script>
<script>
/* V11.3: sparse 5-column x 4-row artwork constellation, original catalog images. */
(()=>{
 const host=document.getElementById('heroArtworks');
 const works=window.DRIIIN_CATALOG||[];
 // Each column has a single fixed size; the row positions share the same grid.
 // Empty cells preserve generous space, while independently drifting artworks can overlap.
 const columns=[{x:9,size:'clamp(25px,4vw,51px)'},{x:29,size:'clamp(31px,5vw,64px)'},{x:49,size:'clamp(24px,3.8vw,48px)'},{x:69,size:'clamp(35px,5.6vw,72px)'},{x:89,size:'clamp(27px,4.5vw,57px)'}];
 const cells=[[0,0],[2,0],[4,0],[1,1],[3,1],[0,2],[2,2],[4,2],[1,3],[3,3]];
 const ids=['COL-001','BW-001','COL-011','BW-004','COL-003','BW-006','COL-007','BW-008','COL-012','COL-009'];
 const rows=[12,35,61,83];
 cells.forEach(([col,row],i)=>{
  const work=works.find(x=>x.id===ids[i])||works[i];if(!work)return;
  const img=document.createElement('img');img.className='hero-float '+(i%3===0?'depth-front':'depth-back');
  img.src=work.image;img.alt='';img.decoding='async';
  img.style.left=columns[col].x+'%';img.style.top=rows[row]+'%';img.style.setProperty('--size',columns[col].size);
  img.style.setProperty('--duration',(14+(i*7)%15)+'s');img.style.setProperty('--delay',(-i*2.3)+'s');
  img.style.setProperty('--dx',((i%2?1:-1)*(38+(i*13)%52))+'px');
  img.style.setProperty('--dy',((i%3?1:-1)*(24+(i*17)%66))+'px');
  img.onerror=()=>img.remove();host.appendChild(img);
 });
})();
</script>
